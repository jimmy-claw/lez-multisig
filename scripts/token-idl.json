{
  "name": "token_program",
  "version": "0.1.0",
  "instruction_type": "token_core::Instruction",
  "instructions": [
    { "name": "new_fungible_definition", "accounts": [{"name": "holder", "writable": true}], "args": [{"name": "supply", "type": "u128"}] },
    { "name": "new_definition_with_metadata", "accounts": [{"name": "holder", "writable": true}], "args": [{"name": "supply", "type": "u128"}, {"name": "name", "type": "string"}] },
    { "name": "transfer", "accounts": [{"name": "sender_holding", "writable": true, "signer": true}, {"name": "recipient_holding", "writable": true}], "args": [{"name": "amount_to_transfer", "type": "u128"}] },
    { "name": "initialize_account", "accounts": [{"name": "holding", "writable": true}], "args": [] },
    { "name": "burn", "accounts": [{"name": "holder", "writable": true, "signer": true}], "args": [{"name": "amount", "type": "u128"}] },
    { "name": "mint", "accounts": [{"name": "to", "writable": true}], "args": [{"name": "amount", "type": "u128"}] },
    { "name": "print_nft", "accounts": [{"name": "owner", "writable": true}], "args": [{"name": "data", "type": "string"}] }
  ]
}
